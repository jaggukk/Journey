# Copy this file to .env and fill in your own values.

JOURNEY_ADMIN_USERNAME=admin
JOURNEY_ADMIN_PASSWORD=change-me

# Optional: instead of a plain password, set a SHA-256 hex digest of it.
# JOURNEY_ADMIN_PASSWORD_HASH=

# A long random string used to sign the sign-in cookie.
JOURNEY_SESSION_SECRET=

# Where journal data lives (defaults to ./data).
# JOURNEY_DATA_DIR=./data

# Store notes and pictures in a Neon Postgres database instead of ./data.
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# Bind address and port. Keep 127.0.0.1 unless you want other devices to connect.
# HOST=127.0.0.1
# PORT=3000
